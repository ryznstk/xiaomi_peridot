# About
ro.mist.display=1220 x 2712, 120 hz
ro.mist.battery=5000mah
ro.mist.soc=Snapdragon® 8S Gen 3
ro.mist.camera=50MP + 8MP 
ro.mist.front=20MP
ro.mist.platform=SM8635
ro.mist.screen=6.67' CrystalRes Flow AMOLED
ro.mist.device.name=Poco F6

# Audio
af.resampler.quality=7 
ro.audio.usb.period_us=20375 
ro.audio.resampler.psd.stopband=144
ro.audio.resampler.psd.halflength=960 
ro.audio.resampler.psd.cutoff_percent=100 
ro.audio.resampler.psd.tbwcheat=0 
ro.audio.resampler.psd.enable_at_samplerate=44100
persist.bluetooth.sbc_hd_higher_bitrate=1
ro.product.mod_device=peridot_global

# Battery
ro.config.small_battery=true

# Dalvik
dalvik.vm.systemuicompilerfilter=speed 
dalvik.vm.systemservercompilerfilter=speed 
dalvik.vm.usap_pool_enabled=true 
dalvik.vm.usap_refill_threshold=1
dalvik.vm.usap_pool_size_max=10 
dalvik.vm.usap_pool_size_min=1 
dalvik.vm.usap_pool_refill_delay_ms=3000
debug.renderengine.backend=skiavkthreaded
debug.sf.enable_hwc_vds=1
debug.sf.latch_unsignaled=0
debug.sf.auto_latch_unsignaled=true
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# Device
ro.product.mod_device=peridot_global

# IMS
persist.dbg.ims_volte_enable=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# Logging
persist.vendor.camera.logInfoMask=false

# Radio Options
persist.radio.volte.dan_support=true
persist.radio.rat_on=combine
persist.radio.data_ltd_sys_ind=1
persist.radio.data_con_rprt=1
persist.radio.calls.on.ims=1
persist.radio.VT_ENABLE=1

# Other Options
persist.sys.cust.lte_config=true

# QTI
ro.vendor.qti.va_aosp.support=1

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.media.recorder-max-base-layer-fps=60
ro.media.xml_variant.profiles=_cliffs_v0

# Disable vsync for cpu rendered apps
debug.cpurend.vsync=false

# LMKD
ro.config.low_ram=false
ro.lmk.swap_compression_ratio=2

# Radio VoNR Calling
persist.rcs.supported=1
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true
persist.vendor.vonr_setting_support=1

# RIL Powersaving
persist.radio.add_power_save=1 
pm.sleep_mode=1 
ro.ril.disable.power.collapse=0
ro.ril.fast.dormancy.rule=1 
ro.ril.fast.dormancy.timeout=3
ro.mot.eri.losalert.delay=1000

# Optimizer
persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=2
